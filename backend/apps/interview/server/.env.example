# ============================================================
# InterviewX AI Backend — Environment Variables Reference
# Copy this file to .env and fill in values before running.
# ============================================================

NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────
# Supabase PostgreSQL connection URLs.
# Leave both blank to automatically use the resilient in-process local JSON store.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ── AI Provider ───────────────────────────────────────────────
# Sarvam AI API key for AI-powered evaluations.
# Leave blank to use the built-in deterministic evaluation engine fallback.
SARVAM_API_KEY=your-sarvam-api-key-here

# ── Security ─────────────────────────────────────────────────
# JWT secret for signing and verifying session tokens.
# Must be at least 32 characters. Use a strong random string in production.
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Comma-separated list of allowed frontend origins (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Rate Limiting ─────────────────────────────────────────────
# Maximum requests per 15-minute window per IP address.
# Default: 200 (production), 10000 (development/test).
# RATE_LIMIT_MAX=200

# ── File Upload ───────────────────────────────────────────────
# Maximum file size in bytes for resume/document uploads.
# Default: 5242880 (5 MB).
MAX_FILE_SIZE=5242880

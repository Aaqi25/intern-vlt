# ============================================================
# THOZHIL Platform — Root Environment Configuration Reference
# Copy to .env before running Docker Compose or production deploy.
# ============================================================

NODE_ENV=production

# Required in production: strong random secret (>=32 chars)
JWT_SECRET=change-this-to-a-long-random-secret-in-production-32chars

# Comma-separated frontend origins allowed by backend CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:8080,http://localhost:5173
JOB_PORTAL_ALLOWED_ORIGINS=http://localhost,http://localhost:8080,http://localhost:5173

# Optional Cloud Databases & AI Keys (services run with local fallback if blank)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=
